generator client {
  provider = "prisma-client-js"
}

model RateLimitBucket {
  id        String   @id @db.VarChar(64)
  hits      Int
  expiresAt DateTime

  @@index([expiresAt])
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  sku          String
  category     String
  qty          Int
  price        Decimal    @db.Decimal(14, 2)
  image        String?

  @@unique([restaurantId, sku])
}

enum RestaurantApproval {
  PENDING
  APPROVED
  REJECTED
}

model Restaurant {
  approvalStatus  RestaurantApproval      @default(APPROVED)
  reviewedAt      DateTime?
  reviewReason    String?                 @db.Text
  active          Boolean                 @default(true)
  suspendedAt     DateTime?
  logoUrl         String?
  address         String?                 @db.Text
  phone           String?
  welcomeMessage  String?
  receiptFooter   String?
  id              Int                     @id @default(autoincrement())
  name            String
  slug            String                  @unique
  ownerId         Int?
  owner           Employee?               @relation("RestaurantOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  products        Product[]
  categories      Category[]
  menuItems       MenuItem[]
  modifierGroups  MenuItemModifierGroup[]
  modifiers       MenuItemModifier[]
  tables          RestaurantTable[]
  orders          Order[]
  payments        Payment[]
  ingredients     Ingredient[]
  stockMovements  StockMovement[]
  employees       Employee[]              @relation("RestaurantEmployees")
  auditLogs       AuditLog[]
  paymentSettings PaymentSettings?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([ownerId])
  @@index([approvalStatus, createdAt])
}

model Category {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  color        String     @default("#356DDB")
  active       Boolean    @default(true)
  menuItems    MenuItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([restaurantId, name])
}

model MenuItem {
  restaurantId   Int
  restaurant     Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  id             Int                     @id @default(autoincrement())
  name           String
  sku            String
  description    String?
  price          Decimal                 @db.Decimal(14, 2)
  saleUnit       String                  @default("จาน")
  image          String?
  available      Boolean                 @default(true)
  categoryId     Int
  category       Category                @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
  recipes        Recipe[]
  modifierGroups MenuItemModifierGroup[]
  modifiers      MenuItemModifier[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([restaurantId, sku])
}

model MenuItemModifierGroup {
  id           Int                @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItemId   Int
  menuItem     MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name         String
  required     Boolean            @default(false)
  minSelect    Int                @default(0)
  maxSelect    Int                @default(1)
  sortOrder    Int                @default(0)
  options      MenuItemModifier[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([menuItemId, name])
  @@index([restaurantId])
}

model MenuItemModifier {
  id           Int                      @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItemId   Int
  menuItem     MenuItem                 @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  groupId      Int?
  group        MenuItemModifierGroup?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name         String
  price        Decimal                  @default(0) @db.Decimal(14, 2)
  active       Boolean                  @default(true)
  recipes      MenuItemModifierRecipe[]
  orderItems   OrderItemModifier[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([menuItemId, name])
  @@index([restaurantId])
}

model MenuItemModifierRecipe {
  id           Int              @id @default(autoincrement())
  modifierId   Int
  modifier     MenuItemModifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  ingredientId Int
  ingredient   Ingredient       @relation(fields: [ingredientId], references: [id])
  quantity     Float

  @@unique([modifierId, ingredientId])
}

model RestaurantTable {
  id           Int            @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  seats        Int            @default(2)
  status       TableStatus    @default(AVAILABLE)
  orders       Order[]
  sessions     TableSession[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([restaurantId, name])
}

model Order {
  id               Int              @id @default(autoincrement())
  restaurantId     Int
  restaurant       Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderNumber      String
  tableId          Int?
  table            RestaurantTable? @relation(fields: [tableId], references: [id])
  type             OrderType        @default(DINE_IN)
  queueNumber      String?
  customerName     String?
  customerPhone    String?
  estimatedReadyAt DateTime?
  pickedUpAt       DateTime?
  status           OrderStatus      @default(SENT)
  paymentStatus    PaymentStatus    @default(UNPAID)
  subtotal         Decimal          @db.Decimal(14, 2)
  discount         Decimal          @default(0) @db.Decimal(14, 2)
  total            Decimal          @db.Decimal(14, 2)
  note             String?
  stockDeducted    Boolean          @default(false)
  items            OrderItem[]
  payment          Payment?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([restaurantId, orderNumber])
  @@unique([restaurantId, queueNumber])
}

model OrderItem {
  id         Int                 @id @default(autoincrement())
  orderId    Int
  order      Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId Int
  menuItem   MenuItem            @relation(fields: [menuItemId], references: [id])
  name       String
  price      Decimal             @db.Decimal(14, 2)
  qty        Int
  note       String?
  status     KitchenStatus       @default(NEW)
  modifiers  OrderItemModifier[]
  guestId    String?
  source     String              @default("STAFF")
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model OrderItemModifier {
  id          Int               @id @default(autoincrement())
  orderItemId Int
  orderItem   OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierId  Int?
  modifier    MenuItemModifier? @relation(fields: [modifierId], references: [id], onDelete: SetNull)
  name        String
  price       Decimal           @default(0) @db.Decimal(14, 2)
  createdAt   DateTime          @default(now())
}

model Payment {
  id             Int           @id @default(autoincrement())
  restaurantId   Int
  restaurant     Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderId        Int           @unique
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method         PaymentMethod
  amount         Decimal       @db.Decimal(14, 2)
  receivedAmount Decimal?      @db.Decimal(14, 2)
  changeAmount   Decimal?      @db.Decimal(14, 2)
  paidAt         DateTime      @default(now())

  @@index([restaurantId])
}

model PaymentSettings {
  id                   Int        @id @default(autoincrement())
  restaurantId         Int        @unique
  restaurant           Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  promptPayEnabled     Boolean    @default(false)
  promptPayAccountName String?
  promptPayIdentifier  String?
  promptPayQrImageUrl  String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
}

model Ingredient {
  id              Int                      @id @default(autoincrement())
  restaurantId    Int
  restaurant      Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name            String
  unit            String
  stock           Float                    @default(0)
  minStock        Float                    @default(0)
  costPerUnit     Decimal                  @default(0) @db.Decimal(18, 6)
  active          Boolean                  @default(true)
  recipes         Recipe[]
  modifierRecipes MenuItemModifierRecipe[]
  movements       StockMovement[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@unique([restaurantId, name])
}

model Recipe {
  id           Int        @id @default(autoincrement())
  menuItemId   Int
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredientId Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Float

  @@unique([menuItemId, ingredientId])
}

model StockMovement {
  id           Int               @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ingredientId Int
  ingredient   Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  type         StockMovementType
  quantity     Float
  reference    String?
  note         String?
  createdAt    DateTime          @default(now())

  @@index([restaurantId])
  @@index([restaurantId, reference, type])
}

model Employee {
  id                        Int            @id @default(autoincrement())
  restaurantId              Int
  restaurant                Restaurant     @relation("RestaurantEmployees", fields: [restaurantId], references: [id], onDelete: Cascade)
  ownedRestaurants          Restaurant[]   @relation("RestaurantOwner")
  username                  String         @unique
  displayName               String
  passwordHash              String
  email                     String?        @db.VarChar(254)
  emailVerifiedAt           DateTime?
  emailVerificationRequired Boolean        @default(false)
  accountTokens             AccountToken[]
  active                    Boolean        @default(true)
  lastLoginAt               DateTime?
  roles                     EmployeeRole[]
  sessions                  AuthSession[]
  auditLogs                 AuditLog[]
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  @@unique([restaurantId, username])
  @@index([email])
}

model EmployeeRole {
  employeeId Int
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role       StaffRole

  @@id([employeeId, role])
}

model AccountToken {
  tokenHash  String   @id @db.VarChar(64)
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  purpose    String   @db.VarChar(16)
  email      String   @db.VarChar(254)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([employeeId, purpose])
  @@index([expiresAt])
}

model PlatformAdmin {
  id           Int               @id @default(autoincrement())
  username     String            @unique
  displayName  String
  passwordHash String
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  sessions     PlatformSession[]
  logs         PlatformLog[]
}

model PlatformSession {
  tokenHash String        @id @db.VarChar(64)
  adminId   Int
  admin     PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([adminId])
  @@index([expiresAt])
}

model PlatformSettings {
  id               Int      @id @default(1)
  name             String   @default("Restaurant Management System")
  logoUrl          String?
  registrationOpen Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

model PlatformLog {
  id           Int            @id @default(autoincrement())
  adminId      Int?
  admin        PlatformAdmin? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  actorName    String
  action       String
  restaurantId Int?
  details      Json?
  createdAt    DateTime       @default(now())

  @@index([createdAt])
  @@index([restaurantId, createdAt])
}

model AuthSession {
  tokenHash  String   @id
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([employeeId])
  @@index([expiresAt])
}

model AuditLog {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  employeeId   Int?
  employee     Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  action       String
  entityType   String
  entityId     String?
  requestId    String?    @db.VarChar(36)
  details      Json?
  createdAt    DateTime   @default(now())

  @@index([employeeId])
  @@index([restaurantId])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, action, createdAt, id])
  @@index([restaurantId, employeeId, createdAt, id])
  @@index([createdAt])
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

enum OrderStatus {
  SENT
  PREPARING
  READY
  SERVED
  PAID
  CANCELLED
}

enum KitchenStatus {
  NEW
  PREPARING
  READY
  SERVED
}

enum PaymentMethod {
  CASH
  PROMPTPAY
  CARD
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}

enum StaffRole {
  OWNER
  CASHIER
  KITCHEN
  STOCK
}

model TableSession {
  id              Int             @id @default(autoincrement())
  tableId         Int
  table           RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  token           String          @unique @db.VarChar(64)
  orderId         Int?            @unique
  paused          Boolean         @default(false)
  billRequestedAt DateTime?
  closedAt        DateTime?
  createdAt       DateTime        @default(now())
  submissions     QrSubmission[]

  @@index([tableId, closedAt])
}

model QrSubmission {
  id        Int          @id @default(autoincrement())
  sessionId Int
  session   TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  requestId String       @db.VarChar(64)
  guestId   String       @db.VarChar(64)
  createdAt DateTime     @default(now())

  @@unique([sessionId, requestId])
  @@index([sessionId, guestId, createdAt])
}
