generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  sku          String
  category     String
  qty          Int
  price        Float
  image        String?

  @@unique([restaurantId, sku])
}

model Restaurant {
  id             Int                     @id @default(autoincrement())
  name           String
  slug           String                  @unique
  ownerId        Int?
  owner          Employee?               @relation("RestaurantOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  products       Product[]
  categories     Category[]
  menuItems      MenuItem[]
  modifierGroups MenuItemModifierGroup[]
  modifiers      MenuItemModifier[]
  tables         RestaurantTable[]
  orders         Order[]
  payments       Payment[]
  ingredients    Ingredient[]
  stockMovements StockMovement[]
  employees      Employee[]              @relation("RestaurantEmployees")
  auditLogs      AuditLog[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([ownerId])
}

model Category {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  color        String     @default("#356DDB")
  active       Boolean    @default(true)
  menuItems    MenuItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([restaurantId, name])
}

model MenuItem {
  restaurantId   Int
  restaurant     Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  id             Int                     @id @default(autoincrement())
  name           String
  sku            String
  description    String?
  price          Float
  saleUnit       String                  @default("จาน")
  image          String?
  available      Boolean                 @default(true)
  categoryId     Int
  category       Category                @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
  recipes        Recipe[]
  modifierGroups MenuItemModifierGroup[]
  modifiers      MenuItemModifier[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([restaurantId, sku])
}

model MenuItemModifierGroup {
  id           Int                @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItemId   Int
  menuItem     MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name         String
  required     Boolean            @default(false)
  minSelect    Int                @default(0)
  maxSelect    Int                @default(1)
  sortOrder    Int                @default(0)
  options      MenuItemModifier[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([menuItemId, name])
  @@index([restaurantId])
}

model MenuItemModifier {
  id           Int                      @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItemId   Int
  menuItem     MenuItem                 @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  groupId      Int?
  group        MenuItemModifierGroup?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name         String
  price        Float                    @default(0)
  active       Boolean                  @default(true)
  recipes      MenuItemModifierRecipe[]
  orderItems   OrderItemModifier[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([menuItemId, name])
  @@index([restaurantId])
}

model MenuItemModifierRecipe {
  id           Int              @id @default(autoincrement())
  modifierId   Int
  modifier     MenuItemModifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  ingredientId Int
  ingredient   Ingredient       @relation(fields: [ingredientId], references: [id])
  quantity     Float

  @@unique([modifierId, ingredientId])
}

model RestaurantTable {
  id           Int         @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  seats        Int         @default(2)
  status       TableStatus @default(AVAILABLE)
  orders       Order[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([restaurantId, name])
}

model Order {
  id               Int              @id @default(autoincrement())
  restaurantId     Int
  restaurant       Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderNumber      String
  tableId          Int?
  table            RestaurantTable? @relation(fields: [tableId], references: [id])
  type             OrderType        @default(DINE_IN)
  queueNumber      String?
  customerName     String?
  customerPhone    String?
  estimatedReadyAt DateTime?
  pickedUpAt       DateTime?
  status           OrderStatus      @default(SENT)
  paymentStatus    PaymentStatus    @default(UNPAID)
  subtotal         Float
  discount         Float            @default(0)
  total            Float
  note             String?
  stockDeducted    Boolean          @default(false)
  items            OrderItem[]
  payment          Payment?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([restaurantId, orderNumber])
  @@unique([restaurantId, queueNumber])
}

model OrderItem {
  id         Int                 @id @default(autoincrement())
  orderId    Int
  order      Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId Int
  menuItem   MenuItem            @relation(fields: [menuItemId], references: [id])
  name       String
  price      Float
  qty        Int
  note       String?
  status     KitchenStatus       @default(NEW)
  modifiers  OrderItemModifier[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model OrderItemModifier {
  id          Int               @id @default(autoincrement())
  orderItemId Int
  orderItem   OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierId  Int?
  modifier    MenuItemModifier? @relation(fields: [modifierId], references: [id], onDelete: SetNull)
  name        String
  price       Float             @default(0)
  createdAt   DateTime          @default(now())
}

model Payment {
  id             Int           @id @default(autoincrement())
  restaurantId   Int
  restaurant     Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderId        Int           @unique
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method         PaymentMethod
  amount         Float
  receivedAmount Float?
  changeAmount   Float?
  paidAt         DateTime      @default(now())

  @@index([restaurantId])
}

model Ingredient {
  id              Int                      @id @default(autoincrement())
  restaurantId    Int
  restaurant      Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name            String
  unit            String
  stock           Float                    @default(0)
  minStock        Float                    @default(0)
  costPerUnit     Float                    @default(0)
  active          Boolean                  @default(true)
  recipes         Recipe[]
  modifierRecipes MenuItemModifierRecipe[]
  movements       StockMovement[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@unique([restaurantId, name])
}

model Recipe {
  id           Int        @id @default(autoincrement())
  menuItemId   Int
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredientId Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Float

  @@unique([menuItemId, ingredientId])
}

model StockMovement {
  id           Int               @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ingredientId Int
  ingredient   Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  type         StockMovementType
  quantity     Float
  reference    String?
  note         String?
  createdAt    DateTime          @default(now())

  @@index([restaurantId])
}

model Employee {
  id               Int            @id @default(autoincrement())
  restaurantId     Int
  restaurant       Restaurant     @relation("RestaurantEmployees", fields: [restaurantId], references: [id], onDelete: Cascade)
  ownedRestaurants Restaurant[]   @relation("RestaurantOwner")
  username         String         @unique
  displayName      String
  passwordHash     String
  active           Boolean        @default(true)
  lastLoginAt      DateTime?
  roles            EmployeeRole[]
  sessions         AuthSession[]
  auditLogs        AuditLog[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([restaurantId, username])
}

model EmployeeRole {
  employeeId Int
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role       StaffRole

  @@id([employeeId, role])
}

model AuthSession {
  tokenHash  String   @id
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([employeeId])
  @@index([expiresAt])
}

model AuditLog {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  employeeId   Int?
  employee     Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  action       String
  entityType   String
  entityId     String?
  details      Json?
  createdAt    DateTime   @default(now())

  @@index([employeeId])
  @@index([restaurantId])
  @@index([createdAt])
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

enum OrderStatus {
  SENT
  PREPARING
  READY
  SERVED
  PAID
  CANCELLED
}

enum KitchenStatus {
  NEW
  PREPARING
  READY
  SERVED
}

enum PaymentMethod {
  CASH
  PROMPTPAY
  CARD
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}

enum StaffRole {
  OWNER
  CASHIER
  KITCHEN
  STOCK
}
