
# ==================================================
# ฐานข้อมูล MySQL phpMyAdmin
# ==================================================
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=restaurant_system
MYSQL_USER=restaurant_user
MYSQL_PASSWORD=restaurant_password
MYSQL_PORT=3306

DATABASE_URL="mysql://restaurant_user:restaurant_password@localhost:3306/restaurant_system"

PMA_HOST=db
PMA_PORT=3306
PHPMYADMIN_PORT=8080


# ==================================================
# MinIO Object Storage
# ใช้สำหรับจัดเก็บไฟล์ เช่น รูปภาพสินค้า
# ==================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=products
NEXT_PUBLIC_MINIO_PUBLIC_URL=http://127.0.0.1:9000/products


# ==================================================
# บัญชีร้านจำลองสำหรับนำเข้า Database
# คำสั่งเพื่อนำเข้าข้อมูลบัญชีร้านจำลอง - npm run db:seed
# ต้องใช้รหัสผ่านอย่างน้อย 8 ตัว
# ==================================================
SEED_OWNER_USERNAME=kruakaneng
SEED_OWNER_PASSWORD=88888888



# ==================================================
# บัญชีผู้ดูแลสำหรับการนำเข้า Database
# คำสั่งเพื่อนำเข้าบัญชีแอดมิน - npm run db:seed:platform
# ต้องใช้รหัสผ่านอย่างน้อย 12 ตัว
# ==================================================
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_DISPLAY_NAME="Admin"
PLATFORM_ADMIN_PASSWORD="888888888888"
SEED_SALES_COUNT=1000


# ==================================================
# Application URLs
# ==================================================
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_PUBLIC_URL=http://localhost:3000

# ============================================================
# ระบบ SMTP สำหรับใช้ตั้งเป็นอีเมลของระบบเพื่อทำหน้าที่ส่งอีเมลยืนยันบัญชีและลิงก์รีเซ็ตรหัสผ่าน เพื่ิอใช้ฟังก์ชัน ลืมรหัสผ่าน ตั้งรหัสผ่านใหม่ และยืนยันอีเมล
# กรอก Host, Port และข้อมูลเข้าสู่ระบบที่ได้รับจากผู้ให้บริการอีเมล
# SMTP_PASSWORD ต้องใช้ SMTP Key หรือ App Password
# ตัวอย่างด้านล่างเป็นการตั้งค่าสำหรับ Gmail; 
# กดลิ้งนี้เพื่อสร้าง https://myaccount.google.com/apppasswords
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD="ใส่-google-app-password"
SMTP_FROM="Restaurant Management System <your-email@gmail.com>"


