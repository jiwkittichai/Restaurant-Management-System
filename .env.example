# ============================================================
# ฐานข้อมูล MySQL สำหรับ localhost
# รหัสผ่านทั้งสามตำแหน่งต้องตรงกันตามชื่อผู้ใช้ที่กำหนด
# ============================================================
MYSQL_ROOT_PASSWORD=change-local-root-password
MYSQL_DATABASE=restaurant_system
MYSQL_USER=restaurant_user
MYSQL_PASSWORD=change-local-database-password
MYSQL_PORT=3306
DATABASE_URL="mysql://restaurant_user:change-local-database-password@localhost:3306/restaurant_system"

# phpMyAdmin ที่เปิดผ่าน Docker
PMA_HOST=db
PMA_PORT=3306
PHPMYADMIN_PORT=8080

# ============================================================
# ที่เก็บรูปภาพ MinIO สำหรับ localhost
# MINIO_API_PORT คือพอร์ต Docker ส่วน MINIO_PORT คือพอร์ตที่เว็บใช้เชื่อมต่อ
# ============================================================
MINIO_ROOT_USER=promraan-local
MINIO_ROOT_PASSWORD=change-local-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=promraan-local
MINIO_SECRET_KEY=change-local-minio-password
MINIO_BUCKET=products
NEXT_PUBLIC_MINIO_PUBLIC_URL=http://127.0.0.1:9000/products

# ============================================================
# ที่อยู่เว็บบน localhost
# ============================================================
AUTH_PUBLIC_URL=http://localhost:3000
QR_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# เว้นว่างบน localhost หากไม่ได้วางเว็บหลัง reverse proxy
TRUSTED_CLIENT_IP_HEADER=

# ============================================================
# ระบบ SMTP สำหรับส่งอีเมลยืนยันบัญชีและลิงก์รีเซ็ตรหัสผ่าน
# กรอก Host, Port และข้อมูลเข้าสู่ระบบที่ได้รับจากผู้ให้บริการอีเมล
# SMTP_PASSWORD ต้องใช้ SMTP Key หรือ App Password ไม่ใช่รหัสผ่านบัญชีปกติ
# ตัวอย่างด้านล่างเป็นการตั้งค่าสำหรับ Gmail; หากใช้ผู้ให้บริการอื่นให้เปลี่ยนค่าตามคู่มือของผู้ให้บริการ
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD="ใส่-google-app-password"
SMTP_FROM="PromRaan — พร้อมร้าน <your-email@gmail.com>"

# ============================================================
# ร้านเริ่มต้น — ใช้โดย npm run db:seed
# คำสั่ง seed จะล้างข้อมูลร้านเดิมบน localhost แล้วสร้างข้อมูลชุดใหม่
# SEED_OWNER_EMAIL ไม่บังคับ; หากไม่กำหนดจะใช้ owner@promraan.local
# ============================================================
SEED_RESTAURANT_NAME="ครัวกันเอง"
SEED_OWNER_USERNAME=kruakaneng
SEED_OWNER_PASSWORD="เปลี่ยนเป็นรหัสผ่านอย่างน้อย-8-ตัว"
SEED_OWNER_EMAIL=your-email@gmail.com
SEED_SALES_COUNT=1683

# ============================================================
# แอดมิน PromRaan — ใช้โดย npm run db:seed:platform
# ต้องใช้รหัสผ่านอย่างน้อย 12 ตัว และไม่ควรซ้ำกับบัญชีร้าน
# ============================================================
PLATFORM_ADMIN_USERNAME=adminpromraan
PLATFORM_ADMIN_DISPLAY_NAME="ผู้ดูแล PromRaan"
PLATFORM_ADMIN_PASSWORD="เปลี่ยนเป็นรหัสผ่านแอดมินอย่างน้อย-12-ตัว"
